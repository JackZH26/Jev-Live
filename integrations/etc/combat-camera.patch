+void UEtcBotAimComponent::RequestPlayerLook(const FRotator& Rotation,int32 Priority,float HoldSeconds,const FRotator& AngularVelocity)
+{
+    if(!Cast<APlayerController>(GetOwner())||!GetWorld()||Rotation.ContainsNaN())return;
+    const double Now=GetWorld()->GetTimeSeconds();
+    if(Now<LookUntil&&Priority<LookPriority)return;
+    LookGoal=Rotation.GetNormalized();LookGoal.Pitch=FMath::Clamp(LookGoal.Pitch,-70.0,70.0);
+    LookPriority=Priority;LookUntil=Now+FMath::Clamp(HoldSeconds,0.05f,1.0f);
+    LookVelocity=AngularVelocity.ContainsNaN()?FRotator::ZeroRotator:AngularVelocity;
+}
+void UEtcBotAimComponent::ResetPlayerLook(){LookUntil=0;LookPriority=0;ViewYaw.Reset();ViewPitch.Reset();LookVelocity=FRotator::ZeroRotator;bHasVisibleBearing=false;VisibleAngularVelocity=FRotator::ZeroRotator;}
+float UEtcBotAimComponent::GetPlayerViewSpeed() const{return float(FMath::Sqrt(ViewYaw.Velocity*ViewYaw.Velocity+ViewPitch.Velocity*ViewPitch.Velocity));}
+void UEtcBotAimComponent::UpdatePlayerLook(float DeltaTime)
+{
+    auto* PC=Cast<APlayerController>(GetOwner());if(!PC)return;
+    if(!EtcJevBridge::HasControlLease(PC->GetPawn())){ResetPlayerLook();return;}
+    if(GetWorld()->GetTimeSeconds()>LookUntil){LookPriority=0;LookGoal=PC->GetControlRotation();LookVelocity=FRotator::ZeroRotator;}
+    const FRotator Current=PC->GetControlRotation();
+    const double Speed=LookPriority>=60?240:150, Acceleration=LookPriority>=60?1150:650;
+    const FRotator Next(ViewPitch.Step(Current.Pitch,LookGoal.Pitch,DeltaTime,110,500,LookVelocity.Pitch),ViewYaw.Step(Current.Yaw,LookGoal.Yaw,DeltaTime,Speed,Acceleration,LookVelocity.Yaw),0);
+    PC->SetControlRotation(Next);
+}
